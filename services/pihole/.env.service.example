# ==============================================================================
# pihole — service-specific environment (ADR-0012)
# Copy to `.env.service` on the host, chmod 600. NEVER commit `.env.service`.
# Platform globals (TZ, DOMAIN, HOST_IP, TAILNET_IP, DATA_ROOT, …) come from the
# root .env via the `.env` symlink — do NOT repeat them here.
# Conventions: docs/standards/environment-variables.md
#
# Pi-hole v6 reads its settings from FTLCONF_* variables whose names mirror the
# keys in pihole.toml. Those names are canonical upstream and are kept verbatim,
# including their case — a documented deviation from UPPER_SNAKE_CASE, same as
# CLOUDFLARE_API_TOKEN in services/caddy.
#
# Non-secret FTLCONF_* settings live in compose.yaml; only the secret is here.
# ==============================================================================

# Admin password for the web UI and the API.
# Generate: openssl rand -base64 24 — fill with an editor, never echo.
# If left empty, Pi-hole generates a random password and prints it to the log.
FTLCONF_webserver_api_password=
