# ==============================================================================
# hermes-agent — service-specific environment (ADR-0012)
# Copy to `.env.service` on the host, chmod 600. NEVER commit `.env.service`.
# Platform globals (TZ, DOMAIN, DATA_ROOT, …) come from the root .env via the
# `.env` symlink — do NOT repeat them here.
#
# Most configuration is written by the interactive `hermes setup` into
# ${DATA_ROOT}/hermes-agent — NOT here. This file holds only the secrets that
# must exist before first start. Upstream variable names kept verbatim
# (documented deviation, same as CLOUDFLARE_API_TOKEN in services/caddy).
# ==============================================================================

# --- LLM provider: OpenAI (ADR-0015) -----------------------------------------
# API key from https://platform.openai.com/api-keys
# NOTE: a ChatGPT Plus subscription does NOT include API access — this is a
# separate key with its own billing. Set a spend limit in OpenAI's dashboard:
# the platform has no cap, and a looping agent bills every iteration.
# Fill with an editor, never echo.
OPENAI_API_KEY=

# Only needed for a non-standard endpoint (e.g. Azure OpenAI). Leave empty otherwise.
OPENAI_BASE_URL=

# --- Gateway API -------------------------------------------------------------
# Protects the API server inside the container (min 8 chars).
# Generate: openssl rand -base64 24
API_SERVER_KEY=

# --- Messaging connectors (full scope, ADR-0015) -----------------------------
# Fill ONLY the channels you enable in `hermes setup`. Every token here is an
# inbound path into an agent that executes tools — add them deliberately.
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_DISCORD_BOT_TOKEN=